// Production datamodel — identical models to prisma/schema.prisma, but wired
// for a managed PostgreSQL database. Keep the two files in sync when models
// change (only the generator/datasource block may differ).
// This file is used by scripts/prepare-prod-migrations.js during deployment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  // Public room identity (e.g. BLU873, shown as @BLU873). Nullable so
  // existing rows backfill lazily; always set for room members.
  playerTag    String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  character    Character?
  quests       Quest[]
  xpHistory    XpHistory[]
  ownedItems   OwnedItem[]
  completions  QuestCompletion[]
  achievements UserAchievement[]
  focusSessions FocusSession[]
  ownedRooms   FocusRoom[]      @relation("RoomOwner")
  roomMemberships RoomMembership[]
  routines     Routine[]
  journeys     Journey[]
  rewards      CustomReward[]
}

model Character {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName  String
  level        Int      @default(1)
  currentXP    Int      @default(0)
  totalXP      Int      @default(0)
  gold         Int      @default(0)

  intellect    Int      @default(1)
  strength     Int      @default(1)
  discipline   Int      @default(1)
  creativity   Int      @default(1)
  social       Int      @default(1)

  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime?

  // Product depth (goals, avatar identity).
  dailyQuestGoal   Int      @default(3)
  weeklyQuestGoal  Int      @default(15)
  dailyGoalClaimedAt  DateTime?
  weeklyGoalClaimedAt DateTime?
  avatarKey    String?
  avatarImage  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Quest {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title        String
  description  String   @default("")
  category     String
  difficulty   String
  xpReward     Int
  goldReward   Int
  attribute    String

  isCompleted  Boolean  @default(false)
  isRecurring  Boolean  @default(false)
  completedAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  completions  QuestCompletion[]
  xpHistory    XpHistory[]
  focusSessions FocusSession[]
  roomGoalFor  RoomMembership[]
}

model QuestCompletion {
  id              String   @id @default(uuid())
  questId         String
  quest           Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  xpEarned        Int
  goldEarned      Int
  attributeGained String
  attributePoints Int
  completedAt     DateTime @default(now())
}

model XpHistory {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId      String?
  quest        Quest?   @relation(fields: [questId], references: [id], onDelete: SetNull)

  type         String
  description  String
  xpChange     Int      @default(0)
  goldChange   Int      @default(0)
  levelBefore  Int?
  levelAfter   Int?
  newLevel     Int?
  streakBefore Int?
  streakAfter  Int?
  attributeType    String?
  attributeChange  Int?
  metadata     String?

  createdAt    DateTime @default(now())

  @@map("XPHistory")
}

model ShopItem {
  id           String   @id @default(uuid())
  name         String
  description  String
  type         String
  price        Int
  rarity       String   @default("COMMON")
  metadata     String   @default("{}")
  isAvailable  Boolean  @default(true)

  ownedBy      OwnedItem[]
}

model OwnedItem {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItemId   String
  shopItem     ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)

  quantity     Int      @default(1)
  purchasedAt  DateTime @default(now())
  isEquipped   Boolean  @default(false)

  @@unique([userId, shopItemId])
}

model AchievementDefinition {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String
  requirements String   @default("{}")
  createdAt    DateTime @default(now())

  unlocks      UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime @default(now())

  @@unique([userId, achievementId])
}

model FocusSession {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId        String?
  quest          Quest?   @relation(fields: [questId], references: [id], onDelete: SetNull)

  mode           String   @default("POMODORO")
  plannedSeconds Int      @default(1500)
  totalSeconds   Int      @default(0)
  status         String   @default("ACTIVE")
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  createdAt      DateTime @default(now())
}

model FocusRoom {
  id        String   @id @default(uuid())
  // Short human-friendly public code (e.g. V7K9P). Server-generated, unique.
  code      String   @unique
  ownerId   String
  owner     User     @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  closedAt  DateTime?

  memberships RoomMembership[]
  sessions    RoomSession[]
}

model RoomSession {
  id              String   @id @default(uuid())
  roomId          String
  room            FocusRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  durationSeconds Int
  // Elapsed seconds banked across pause/resume. Authoritative remaining =
  // durationSeconds - bankedSeconds - (RUNNING ? now - startedAt : 0).
  bankedSeconds   Int      @default(0)
  startedAt       DateTime @default(now())
  status          String   @default("RUNNING")
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([roomId, status])
}

model RoomMembership {
  id          String    @id @default(uuid())
  roomId      String
  room        FocusRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Optional public goal, resolved live from an owned ACTIVE quest.
  goalQuestId String?
  goalQuest   Quest?    @relation(fields: [goalQuestId], references: [id], onDelete: SetNull)
  joinedAt    DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  leftAt      DateTime?

  @@index([roomId, leftAt])
  @@index([userId, leftAt])
}

model Routine {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  period    String   @default("MORNING")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  items     RoutineItem[]
}

model RoutineItem {
  id        String   @id @default(uuid())
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model Journey {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("JOURNEY")
  title     String
  totalDays Int
  startedAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model CustomReward {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  cost      Int
  createdAt DateTime @default(now())
}