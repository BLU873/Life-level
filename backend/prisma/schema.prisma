generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  character    Character?
  quests       Quest[]
  xpHistory    XpHistory[]
  ownedItems   OwnedItem[]
  completions  QuestCompletion[]
  achievements UserAchievement[]
  focusSessions FocusSession[]
  routines     Routine[]
  journeys     Journey[]
  rewards      CustomReward[]
}

model Character {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName  String
  level        Int      @default(1)
  currentXP    Int      @default(0)
  totalXP      Int      @default(0)
  gold         Int      @default(0)

  intellect    Int      @default(1)
  strength     Int      @default(1)
  discipline   Int      @default(1)
  creativity   Int      @default(1)
  social       Int      @default(1)

  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime?

  // Product depth (goals, avatar identity).
  dailyQuestGoal   Int      @default(3)
  weeklyQuestGoal  Int      @default(15)
  dailyGoalClaimedAt  DateTime?
  weeklyGoalClaimedAt DateTime?
  avatarKey    String?
  avatarImage  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Quest {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title        String
  description  String   @default("")
  category     String
  difficulty   String
  xpReward     Int
  goldReward   Int
  attribute    String

  isCompleted  Boolean  @default(false)
  isRecurring  Boolean  @default(false)
  completedAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  completions  QuestCompletion[]
  xpHistory    XpHistory[]
  focusSessions FocusSession[]
}

model QuestCompletion {
  id              String   @id @default(uuid())
  questId         String
  quest           Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  xpEarned        Int
  goldEarned      Int
  attributeGained String
  attributePoints Int
  completedAt     DateTime @default(now())
}

model XpHistory {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId      String?
  quest        Quest?   @relation(fields: [questId], references: [id], onDelete: SetNull)

  type         String
  description  String
  xpChange     Int      @default(0)
  goldChange   Int      @default(0)
  levelBefore  Int?
  levelAfter   Int?
  newLevel     Int?
  streakBefore Int?
  streakAfter  Int?
  attributeType    String?
  attributeChange  Int?
  metadata     String?

  createdAt    DateTime @default(now())

  @@map("XPHistory")
}

model ShopItem {
  id           String   @id @default(uuid())
  name         String
  description  String
  type         String
  price        Int
  rarity       String   @default("COMMON")
  metadata     String   @default("{}")
  isAvailable  Boolean  @default(true)

  ownedBy      OwnedItem[]
}

model OwnedItem {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItemId   String
  shopItem     ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)

  quantity     Int      @default(1)
  purchasedAt  DateTime @default(now())
  isEquipped   Boolean  @default(false)

  @@unique([userId, shopItemId])
}

model AchievementDefinition {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String
  requirements String   @default("{}")
  createdAt    DateTime @default(now())

  unlocks      UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime @default(now())

  @@unique([userId, achievementId])
}

model FocusSession {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId        String?
  quest          Quest?   @relation(fields: [questId], references: [id], onDelete: SetNull)

  mode           String   @default("POMODORO")
  plannedSeconds Int      @default(1500)
  totalSeconds   Int      @default(0)
  status         String   @default("ACTIVE")
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  createdAt      DateTime @default(now())
}

model Routine {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  period    String   @default("MORNING")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  items     RoutineItem[]
}

model RoutineItem {
  id        String   @id @default(uuid())
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model Journey {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("JOURNEY")
  title     String
  totalDays Int
  startedAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model CustomReward {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  cost      Int
  createdAt DateTime @default(now())
}
