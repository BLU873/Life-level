# Backend
JWT_SECRET=your-super-secret-jwt-key-change-this
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database (SQLite - auto configured)
DATABASE_URL="file:./dev.db"

# --- Optional / production ---
# When deploying the frontend and API to different hosts you can either:
#   1) add a Vercel rewrite "/api -> <backend>/api" (recommended, keeps cookies same-site), or
#   2) build the frontend with VITE_API_URL pointing at the deployed API.
# VITE_API_URL=https://your-api.example.com/api